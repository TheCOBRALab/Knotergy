#Data Arrangement:
#For the 4x4 tables, each starting pair needs its own table.
#This is the AU table:  
#			5' --> 3'      
#			    AX
#			    1Y
#			3' <-- 5'   
#			    Y->          
#	   	---------------------------- 
#	(X) 	A	C	G	U  
#	 | 	----------------------------
#	 V   
#	(A) 	-0.8	-1.0	-0.8	-1.0
#	(C) 	-0.6	-0.7	-0.6	-0.7
#	(G) 	-0.8	-1.0	-0.8	-1.0
#	(1) 	-0.6	-0.8	-0.6	-0.8

#An energy of "." is "infinity," i.e. not allowed.





#		5' --> 3'
		   AX
		   1Y
#		3' <-- 5'
#		    Y 
# 	---------------------------- 
	A	C	G	1    
# 	----------------------------  
A	-1.0	-1.1	-1.2	-1.1
C	-0.8	-0.9	-0.8	-0.9
G	-2.2	-1.1	-2.0	-1.1
1	-0.8	-1.1	-0.8	-2.1




#		5' --> 3'
		   CX
		   GY
#		3' <-- 5'
#		    Y 
# 	---------------------------- 
	A	C	G	1    
# 	----------------------------  
A	-1.5	-1.5	-1.4	-1.5
C	-1.0	-1.1	-1.0	-0.9
G	-2.3	-1.5	-2.4	-1.5
1	-1.0	-1.7	-1.0	-2.4


#		5' --> 3'
		   GX
		   CY
#		3' <-- 5'
#		    Y 
# 	---------------------------- 
	A	C	G	1    
# 	----------------------------  
A	-1.1	-1.5	-1.3	-1.5
C	-1.1	-0.7	-1.1	-0.9
G	-2.5	-1.5	-2.2	-1.5
1	-1.1	-1.9	-1.1	-2.0





#		5' --> 3'
		   GX
		   1Y
#		3' <-- 5'
#		    Y 
# 	---------------------------- 
	A	C	G	1    
# 	----------------------------  
A	-1.0	-1.1	-1.2	-1.1
C	-0.8	-0.9	-0.7	-0.9
G	-2.1	-1.1	-2.0	-1.1
1	-0.8	-1.1	-0.8	-2.1





#		5' --> 3'
		   1X
		   AY
#		3' <-- 5'
#		    Y 
# 	---------------------------- 
	A	C	G	1   
# 	----------------------------  
A	-1.4	-1.6	-1.9	-1.6
C	-0.9	-0.9	-0.9	-0.8
G	-2.7	-1.6	-2.3	-1.6
1	-0.9	-1.0	-0.9	-2.3






#		5' --> 3'
		   1X
		   GY
#		3' <-- 5'
#		    Y 
# 	---------------------------- 
	A	C	G	1    
# 	----------------------------  
A	-1.4	-1.6	-1.9	-1.6
C	-0.9	-0.9	-0.9	-0.8
G	-2.7	-1.6	-2.3	-1.6
1	-0.9	-1.0	-0.9	-2.3
