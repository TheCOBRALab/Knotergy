#Data Arrangement:
#For the 4x4 tables, each starting pair needs its own table.
#This is the AU table:  
#			5' --> 3'      
#			    AX
#			    UY
#			3' <-- 5'   
#			    Y->          
#	   	---------------------------- 
#	(X) 	A	C	G	1  
#	 | 	----------------------------
#	 V   
#	(A) 	.	.	.	-0.9
#	(C) 	.	.	-2.2	.
#	(G) 	.	-2.1	.	-0.6
#    (1) 

#An energy of "." is "infinity," i.e. not allowed.





#		5' --> 3'
		   CX
		   GY
#		3' <-- 5'
#		    Y 
# 	---------------------------- 
	A	C	G	1    
# 	----------------------------  
A	.	.	.	-2.6
C	.	.	-3.3	.
G	.	-2.4	.	-1.7
1	-2.2	.	-2.0	.


#		5' --> 3'
		   GX
		   CY
#		3' <-- 5'
#		    Y 
# 	---------------------------- 
	A	C	G	1    
# 	----------------------------  
A	.	.	.	-2.5
C	.	.	-3.4	.
G	.	-3.3	.	-2.6
1	-2.8	.	-2.3	.




#		5' --> 3'
		   AX
		   1Y
#		3' <-- 5'
#		    Y 
# 	---------------------------- 
	A	C	G	1    
# 	----------------------------  
A	.	.	.	-1.2
C	.	.	-2.8	.
G	.	-2.2	.	-0.4
1	-1.5	.	-1.2	.


#		5' --> 3'
		   1X
		   AY
#		3' <-- 5'
#		    Y 
# 	---------------------------- 
	A	C	G	1    
# 	----------------------------  
A	.	.	.	-1.8
C	.	.	-2.5	.
G	.	-2.6	.	-0.9
1	-1.2	.	-0.4	.


#		5' --> 3'
		   GX
		   1Y
#		3' <-- 5'
#		    Y 
# 	---------------------------- 
	A	C	G	1    
# 	----------------------------  
A	.	.	.	-0.4
C	.	.	-2.3	.
G	.	-2.0	.	-0.6
1	-1.2	.	-0.3	.


#		5' --> 3'
		   1X
		   GY
#		3' <-- 5'
#		    Y 
# 	---------------------------- 
	A	C	G	1    
# 	----------------------------  
A	.	.	.	-0.9	
C	.	.	-2.6	.
G	.	-1.7	.	-1.9
1	-0.4	.	-0.6	.

