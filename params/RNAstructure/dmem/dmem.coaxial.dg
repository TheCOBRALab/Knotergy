#Data Arrangement:
#For the 4x4 tables, each starting pair needs its own table.
#This is the AA table:
#                       5' --> 3'
#                           AX
#                           UY
#                       3' <-- 5'
#                           Y->
#               ----------------------------
#       (X)     A       C       G       U
#        |      ----------------------------
#        V
#       (A)     .       .       .       -0.8
#       (C)     .       .       -2.2    .
#       (G)     .       -2.2    .       -0.1
#       (U)     -0.9    .       -0.7    .

#An energy of "." is "infinity," i.e. not allowed.


#               5' --> 3'
                   AX
                   UY
#               3' <-- 5'
#                   Y
#       ----------------------------
        A       C       G       U
#       ----------------------------
A       .       .       .       -0.8
C       .       .       -2.2    .
G       .       -2.2    .       -0.1
U       -0.9    .       -0.7    .


#               5' --> 3'
                   CX
                   GY
#               3' <-- 5'
#                   Y
#       ----------------------------
        A       C       G       U
#       ----------------------------
A       .       .       .       -2.1
C       .       .       -3.4    .
G       .       -2.7    .       -1.3
U       -2.2    .       -1.6    .


#               5' --> 3'
                   GX
                   CY
#               3' <-- 5'
#                   Y
#       ----------------------------
        A       C       G       U
#       ----------------------------
A       .       .       .       -2.2
C       .       .       -3.2    .
G       .       -3.4    .       -1.2
U       -2.2    .       -1.4    .


#               5' --> 3'
                   GX
                   UY
#               3' <-- 5'
#                   Y
#       ----------------------------
        A       C       G       U   
#       ----------------------------
A       .       .       .       -0.4
C       .       .       -1.4    .   
G       .       -1.6    .       +0.5
U       -0.7    .       +2.1    .


#               5' --> 3'
                   UX
                   AY
#               3' <-- 5'
#                   Y
#       ----------------------------
        A       C       G       U   
#       ----------------------------
A       .       .       .       -1.1
C       .       .       -2.2    .   
G       .       -2.1    .       -0.2
U       -0.8    .       -0.4    .


#               5' --> 3'
                   UX
                   GY
#               3' <-- 5'
#                   Y
#       ----------------------------
        A       C       G       U   
#       ----------------------------
A       .       .       .       -0.2
C       .       .       -1.2    .   
G       .       -1.3    .       +0.3
U       -0.1    .       +0.5    .
