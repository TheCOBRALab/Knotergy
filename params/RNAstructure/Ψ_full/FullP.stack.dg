#Data Arrangement:
#For the 4x4 tables, each starting pair needs its own table.
#This is the AU table:  
#			5' --> 3'      
#			    AX
#			    UY
#			3' <-- 5'   
#			    Y->          
#	   	---------------------------- 
#	(X) 	A	C	G	U	P  
#	 | 	----------------------------
#	 V   
#	(A) 	.	.	.	-0.9
#	(C) 	.	.	-2.2	.
#	(G) 	.	-2.1	.	-0.6
#	(U) 	-1.1	.	-1.4	.
#    (P) 

#An energy of "." is "infinity," i.e. not allowed.




#		5' --> 3'
		   CX
		   GY
#		3' <-- 5'
#		    Y 
# 	---------------------------- 
	A	C	G	P    
# 	----------------------------  
A	.	.	.	-2.4
C	.	.	-3.3	.
G	.	-2.4	.	-1.4
P	-2.7	.	-2.8	.


#		5' --> 3'
		   GX
		   CY
#		3' <-- 5'
#		    Y 
# 	---------------------------- 
	A	C	G	P    
# 	----------------------------  
A	.	.	.	-2.4
C	.	.	-3.4	.
G	.	-3.3	.	-1.8
P	-3.1	.	-3.2	.








#		5' --> 3'
		   AX
		   PY
#		3' <-- 5'
#		    Y 
# 	---------------------------- 
	A	C	G	P    
# 	----------------------------  
A	.	.	.	-0.9
C	.	.	-3.1	.
G	.	-2.7	.	-0.4
P	-1.9	.	-2.3	.


#		5' --> 3'
		   PX
		   AY
#		3' <-- 5'
#		    Y 
# 	---------------------------- 
	A	C	G	P    
# 	----------------------------  
A	.	.	.	-1.5
C	.	.	-2.4	.
G	.	-2.4	.	-0.1
P	-0.9	.	-1.2	.


#		5' --> 3'
		   GX
		   PY
#		3' <-- 5'
#		    Y 
# 	---------------------------- 
	A	C	G	P    
# 	----------------------------  
A	.	.	.	-1.2
C	.	.	-3.2	.
G	.	-2.8	.	-0.3
P	-2.3	.	-2.3	.


#		5' --> 3'
		   PX
		   GY
#		3' <-- 5'
#		    Y 
# 	---------------------------- 
	A	C	G	P    
# 	----------------------------  
A	.	.	.	-0.1
C	.	.	-1.8	.
G	.	-1.4	.	-1.0
P	-0.4	.	-0.3	.


