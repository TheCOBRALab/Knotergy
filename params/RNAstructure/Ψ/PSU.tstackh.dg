#Data Arrangement:
#For the 4x4 tables, each starting pair needs its own table.
#This is the AU table:  
#			5' --> 3'      
#			    AX
#			    UY
#			3' <-- 5'   
#			    Y->          
#	   	---------------------------- 
#	(X) 	A	C	G	U  
#	 | 	----------------------------
#	 V   
#	(A) 	-0.8	-1.0	-0.8	-1.0
#	(C) 	-0.6	-0.7	-0.6	-0.7
#	(G) 	-0.8	-1.0	-0.8	-1.0
#	(U) 	-0.6	-0.8	-0.6	-0.8

#An energy of "." is "infinity," i.e. not allowed.


#		5' --> 3'
		   AX
		   UY
#		3' <-- 5'
#		    Y 
# 	---------------------------- 
	A	C	G	U	P    
# 	----------------------------  
A	-0.8	-1.0	-0.8	-1.0	-1.0
C	-0.6	-0.7	-0.6	-0.7	-1.0
G	-1.7	-1.0	-1.6	-1.0	-1.0
U	-0.6	-0.8	-0.6	-1.7	-2.3
P	-0.6	-1.3	-0.6	-2.8	-1.9


#		5' --> 3'
		   AX
		   PY
#		3' <-- 5'
#		    Y 
# 	---------------------------- 
	A	C	G	U	P    
# 	----------------------------  
A	-1.1	-1.4	-1.3	-1.0	-1.0
C	-1.4	-1.2	-0.6	-1.3	-1.2
G	-2.3	-1.0	-2.1	-1.0	-1.0
U	-0.6	-1.3	-0.6	-2.3	-2.2
P	-0.6	-1.2	-0.6	-2.2	-2.2


#		5' --> 3'
		   CX
		   GY
#		3' <-- 5'
#		    Y 
# 	---------------------------- 
	A	C	G	U	P    
# 	----------------------------  
A	-1.5	-1.5	-1.4	-1.5	-1.5
C	-1.0	-1.1	-1.0	-0.8	-1.1
G	-2.3	-1.5	-2.4	-1.5	-1.5
U	-1.0	-1.4	-1.0	-2.1	-2.7
P	-1.0	-1.9	-1.0	-3.2	-3.0


#		5' --> 3'
		   GX
		   CY
#		3' <-- 5'
#		    Y 
# 	---------------------------- 
	A	C	G	U	P    
# 	----------------------------  
A	-1.1	-1.5	-1.3	-1.5	-1.5
C	-1.1	-0.7	-1.1	-0.5	-0.8
G	-2.5	-1.5	-2.2	-1.5	-1.5
U	-1.1	-1.0	-1.1	-1.6	-2.3
P	-1.1	-1.5	-1.1	-2.7	-2.3


#		5' --> 3'
		   GX
		   UY
#		3' <-- 5'
#		    Y 
# 	---------------------------- 
	A	C	G	U	P    
# 	----------------------------  
A	-0.3	-1.0	-0.8	-1.0	-1.0
C	-0.6	-0.7	-0.6	-0.7	-1.0
G	-1.5	-1.0	-1.6	-1.0	-1.0
U	-0.6	-0.8	-0.6	-1.5	-2.3
P	-0.6	-1.3	-0.6	-2.8	-1.9


#		5' --> 3'
		   GX
		   PY
#		3' <-- 5'
#		    Y 
# 	---------------------------- 
	A	C	G	U	P    
# 	----------------------------  
A	-1.1	-1.4	-1.3	-1.0	-1.0
C	-1.4	-1.2	-0.6	-1.3	-1.2
G	-2.3	-1.0	-2.1	-1.0	-1.0
U	-0.6	-1.3	-0.6	-2.3	-2.2
P	-0.6	-1.2	-0.6	-2.2	-2.3


#		5' --> 3'
		   UX
		   AY
